import {
  "Nanaloveyuki/BitLogger/src" @bitlogger,
  "Nanaloveyuki/BitLogger/src/file_runtime",
  "Nanaloveyuki/BitLogger/src/utils" @file_utils,
  "Nanaloveyuki/BitLogger/src-async/utils",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/fs",
}

supported_targets = "native+wasm+js"

warnings = "-25-29"

options(
  targets: {
    "async_logger_native.mbt": [ "native" ],
    "async_logger_stub.mbt": [ "js", "wasm" ],
    "file_backend_native.mbt": [ "native" ],
    "file_backend_stub.mbt": [ "js", "wasm" ],
    "async_native_file_integration_test.mbt": [ "native" ],
    "async_file_sink_test.mbt": [ "native" ],
    "sync_file_regression_test.mbt": [ "native" ],
  },
)
