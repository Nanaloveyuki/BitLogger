import {
  "Nanaloveyuki/BitLogger/src" @bitlogger,
  "maria/json_parser" @json_parser,
  "moonbitlang/async" @async,
  "moonbitlang/async/aqueue" @aqueue,
  "moonbitlang/core/env" @env,
  "moonbitlang/core/ref",
}

options(
  targets: {
